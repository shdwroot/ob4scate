APP_ENV=development
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=ob4scate-auth
JWT_AUDIENCE=ob4scate-api
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_TENANT=default
SESSION_BACKEND=redis
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=tokenization_vault_db
DB_PORT=5432
DB_USER=vault_user
DB_PASS=replace-with-a-long-random-database-password
DB_NAME=vault_db
VAULT_ENCRYPTION_KEY=generate-with-python-c-from-cryptography-fernet-import-Fernet

AUDIT_LOG_SIGNING_KEY=replace-with-at-least-32-random-characters
AUDIT_LOG_DB=/app/data/audit_logs.db

LITELLM_BASE_URL=http://ollama:11434
DEFAULT_LLM_MODEL=mistral
